#!/bin/bash
set -euo pipefail
umask 077
# Same lock as deployments: never rotate the tunnel while a release is being installed.
exec 9>/opt/lumina/deploy.lock
flock -n 9
cd /opt/lumina
curl --fail --silent --max-time 5 http://127.0.0.1:${port}/api/health >/dev/null || { echo 'API not healthy on loopback; deploy first' >&2; exit 1; }
${tunnel_setup}
